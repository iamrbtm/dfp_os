TREND_SCOUT_SERVICE_ENV=local
TREND_SCOUT_SERVICE_NAME=dfp-trend-scout
TREND_SCOUT_API_HOST=0.0.0.0
TREND_SCOUT_API_PORT=8093

# Database — own logical DB on the shared Postgres container
TREND_SCOUT_DATABASE_URL=postgresql+asyncpg://dfp_trend_scout:change-me@db:5432/dfp_trend_scout

# Redis — DB 2 for trend-scout streams, DB 1 for Celery broker
TREND_SCOUT_REDIS_URL=redis://redis:6379/2
TREND_SCOUT_CELERY_BROKER_URL=redis://redis:6379/1
TREND_SCOUT_CELERY_RESULT_BACKEND=redis://redis:6379/1

# Internal API token — shared with the Flask app
TREND_SCOUT_INTERNAL_API_TOKEN=change-me-in-production

# Audit log forwarding
TREND_SCOUT_AUDIT_LOG_BASE_URL=http://audit-log:8090
TREND_SCOUT_AUDIT_LOG_TOKEN=change-me-audit-token
TREND_SCOUT_AUDIT_LOG_ENABLED=false

# AI provider for report synthesis (deterministic fallback when blank)
TREND_SCOUT_OPENAI_API_KEY=
TREND_SCOUT_OPENAI_MODEL_TREND_SCOUT=gpt-4o-mini
TREND_SCOUT_AI_PROVIDER=openai

# Pipeline tunables
TREND_SCOUT_FETCHER_POOL_WORKERS=4
TREND_SCOUT_FETCHER_TIMEOUT_SECONDS=30
TREND_SCOUT_PIPELINE_SOFT_TIME_LIMIT_SECONDS=900
TREND_SCOUT_PIPELINE_HARD_TIME_LIMIT_SECONDS=960

# Weights — seed defaults on first boot
TREND_SCOUT_WEIGHTS_DEFAULT_SEED_ON_START=true
