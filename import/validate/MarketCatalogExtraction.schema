{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dudefish.dev/schemas/market_catalog_extraction.schema.json",
  "title": "MarketCatalogExtraction",
  "description": "Output of ChatGPT/Gemini extraction for one market catalog listing. Includes a research audit trail. Maps 1:1 to MarketCatalogListing + MarketCatalogBoothTier rows in DFPos.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "interest_level",
    "location",
    "timing",
    "scale",
    "amenities",
    "organizer",
    "rules",
    "booth_tiers",
    "field_confidence",
    "sources_consulted",
    "search_queries_used",
    "research_complete"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": ["string", "null"] },
    "website_url": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://",
      "maxLength": 500
    },
    "category_hint": {
      "type": ["string", "null"],
      "enum": [
        null,
        "farmers_market",
        "craft_market",
        "holiday_market",
        "antique_fair",
        "food_festival",
        "art_walk",
        "pop_up",
        "vendor_expo",
        "other"
      ]
    },
    "interest_level": {
      "type": "string",
      "enum": ["watching", "interested", "priority"]
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country"],
      "properties": {
        "location_name": { "type": ["string", "null"], "maxLength": 200 },
        "address":      { "type": ["string", "null"], "maxLength": 300 },
        "city":         { "type": ["string", "null"], "maxLength": 100 },
        "state":        { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
        "zip_code":     { "type": ["string", "null"], "maxLength": 20 },
        "country":      { "type": "string", "minLength": 2, "maxLength": 2, "default": "US" },
        "latitude":     { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude":    { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
      }
    },

    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "is_recurring"],
      "properties": {
        "default_start_time":     { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "default_end_time":       { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "timezone":               { "type": "string", "maxLength": 50, "default": "America/Chicago" },
        "is_recurring":           { "type": "boolean" },
        "rrule":                  { "type": ["string", "null"] },
        "recurrence_description": { "type": ["string", "null"], "maxLength": 255 },
        "anchor_date":            { "type": ["string", "null"], "format": "date" },
        "next_occurrence_date":   { "type": ["string", "null"], "format": "date" },
        "last_occurrence_date":   { "type": ["string", "null"], "format": "date" }
      }
    },

    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimated_vendor_count":   { "type": ["integer", "null"], "minimum": 0 },
        "estimated_attendee_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "amenities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "power_available", "wifi_available", "food_available",
        "restrooms_available", "indoor", "covered_outdoor", "outdoor"
      ],
      "properties": {
        "power_available":    { "type": "boolean" },
        "wifi_available":     { "type": "boolean" },
        "food_available":     { "type": "boolean" },
        "restrooms_available":{ "type": "boolean" },
        "indoor":             { "type": "boolean" },
        "covered_outdoor":    { "type": "boolean" },
        "outdoor":            { "type": "boolean" },
        "parking_notes":      { "type": ["string", "null"] }
      }
    },

    "organizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name":                              { "type": ["string", "null"], "maxLength": 200 },
        "email":                             { "type": ["string", "null"], "format": "email", "maxLength": 200 },
        "phone":                             { "type": ["string", "null"], "maxLength": 60 },
        "application_url":                   { "type": ["string", "null"], "format": "uri", "pattern": "^https?://", "maxLength": 500 },
        "application_contact":               { "type": ["string", "null"], "maxLength": 200 },
        "application_deadline_description":  { "type": ["string", "null"], "maxLength": 255 }
      }
    },

    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booth_rules":         { "type": ["string", "null"] },
        "required_documents":  { "type": ["string", "null"] }
      }
    },

    "booth_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "sort_order"],
        "properties": {
          "label":          { "type": "string", "minLength": 1, "maxLength": 80 },
          "dimensions":     { "type": ["string", "null"], "maxLength": 80 },
          "price":          { "type": ["number", "null"], "minimum": 0 },
          "corner_premium": { "type": ["number", "null"], "minimum": 0 },
          "notes":          { "type": ["string", "null"], "maxLength": 200 },
          "sort_order":     { "type": "integer", "minimum": 0 }
        }
      }
    },

    "notes": { "type": ["string", "null"] },

    "field_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "location", "timing", "scale", "amenities", "organizer", "rules", "booth_tiers"],
      "properties": {
        "identity":    { "type": "string", "enum": ["high", "medium", "low"] },
        "location":    { "type": "string", "enum": ["high", "medium", "low"] },
        "timing":      { "type": "string", "enum": ["high", "medium", "low"] },
        "scale":       { "type": "string", "enum": ["high", "medium", "low"] },
        "amenities":   { "type": "string", "enum": ["high", "medium", "low"] },
        "organizer":   { "type": "string", "enum": ["high", "medium", "low"] },
        "rules":       { "type": "string", "enum": ["high", "medium", "low"] },
        "booth_tiers": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    },

    "sources_consulted": {
      "type": "array",
      "description": "URLs the model actually fetched or read content from, in order visited.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "purpose"],
        "properties": {
          "url":     { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 1000 },
          "purpose": { "type": "string", "maxLength": 200, "description": "Why this source was consulted, e.g. 'original flyer image' or 'application page to get booth fee'" },
          "fields_filled": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Top-level schema paths that this source contributed to, e.g. ['booth_tiers', 'organizer.email']"
          }
        }
      }
    },

    "search_queries_used": {
      "type": "array",
      "description": "Web search queries the model issued, in order. Empty if none were used.",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },

    "research_complete": {
      "type": "boolean",
      "description": "true if the model used its full budget or is satisfied; false only if a transient error should trigger a human retry."
    },

    "extraction_notes": {
      "type": ["string", "null"],
      "description": "1-3 sentences: what was researched, what was guessed, what the human should double-check."
    }
  }
}