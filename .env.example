FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://dfpos:dfpos@localhost:5432/dfpos
TEST_DATABASE_URL=postgresql+psycopg://dfpos:dfpos@localhost:5432/dfpos_test
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_DB=dfpos
POSTGRES_USER=dfpos
POSTGRES_PASSWORD=dfpos
APP_NAME=Dude Fish OS
APP_BASE_URL=http://localhost:5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
UPLOAD_FOLDER=uploads
# Issue 20 — single upload limit. Must match the ProductModelUploadForm
# FileSize validator (256 MB). Files above this are rejected with HTTP 413.
MAX_CONTENT_LENGTH_MB=256
# Issue 4 — run analysis inline (bypass Celery) only in dev/test, never prod.
ANALYSIS_SYNC_MODE=false
POS_CARD_PROCESSING_ENABLED=false
POS_CARD_PROCESSOR=placeholder
WEATHER_USER_AGENT=Dude Fish OS (admin@example.com)

# Receipt Management
FILE_STORAGE_BACKEND=local
RECEIPT_STORAGE_DRIVER=local
RECEIPT_STORAGE_PATH=uploads/receipts
MARKET_DOCUMENTS_PATH=uploads/markets
PRODUCT_ASSETS_PATH=uploads/products
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_HOST_PORT=8333
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKETS=true
RECEIPT_STORAGE_BUCKET=receipts
SIGN_STORAGE_BUCKET=signs
MARKET_DOCUMENTS_BUCKET=markets
PRODUCT_ASSETS_BUCKET=products
RECEIPT_MAX_UPLOAD_MB=25
RECEIPT_ALLOWED_TYPES=image/jpeg,image/png,image/heic,image/heif,application/pdf
RECEIPT_OCR_PROVIDER=paddleocr
RECEIPT_AI_PROVIDER=openai
AI_PROVIDER=openai
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_RECEIPTS=gpt-4o-mini
OPENAI_MODEL_ANALYTICS=gpt-4o-mini
OPENAI_MODEL_TREND_SCOUT=gpt-4o-mini
OPENAI_MODEL_MARKET_CATALOG=gpt-4o-mini
OPENAI_MODEL_PRODUCT_STORY=gpt-4o-mini
KILO_API_KEY=
KILO_GATEWAY_BASE_URL=https://api.kilo.ai/api/gateway
KILO_MODEL=anthropic/claude-sonnet-4.5
KILO_MODEL_RECEIPTS=anthropic/claude-sonnet-4.5
KILO_MODEL_ANALYTICS=anthropic/claude-sonnet-4.5
KILO_MODEL_TREND_SCOUT=anthropic/claude-sonnet-4.5
KILO_MODEL_MARKET_CATALOG=anthropic/claude-sonnet-4.5
KILO_MODEL_PRODUCT_STORY=anthropic/claude-sonnet-4.5
OPENAI_IMAGE_MODEL=dall-e-3
ETSY_API_KEY=
PINTEREST_API_KEY=
SERPAPI_API_KEY=
TIKTOK_RESEARCH_ACCESS_TOKEN=
AI_RECEIPT_PARSING_ENABLED=false
AI_ANALYTICS_INSIGHTS_ENABLED=false
AI_PRODUCT_STORY_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FALLBACK_URL=http://localhost:11434
OLLAMA_RECEIPT_MODEL=llama3
RECEIPT_ENABLE_API_FALLBACK=false
RECEIPT_API_PROVIDER=
TAGGUN_API_KEY=
MINDEE_API_KEY=
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
RECEIPT_DUPLICATE_STRICTNESS=normal
RECEIPT_LOW_CONFIDENCE_THRESHOLD=0.80

# Celery / Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Audit Log Microservice
AUDIT_LOG_BASE_URL=http://audit-log-service:8090
AUDIT_LOG_TOKEN=change-me-audit-token
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FAIL_CLOSED=false
AUDIT_LOG_FAIL_CLOSED_FOR_FINANCIAL_ACTIONS=false
# Audit outbox (Redis-backed durable queue when the microservice is unavailable)
AUDIT_REDIS_URL=redis://localhost:6379/0
AUDIT_OUTBOX_KEY=audit:outbox
AUDIT_OUTBOX_MAX_SIZE=100000
AUDIT_OUTBOX_FLUSH_INTERVAL_SECONDS=30
AUDIT_OUTBOX_REPLAY_INTERVAL_SECONDS=60
AUDIT_OUTBOX_BATCH_SIZE=200
AUDIT_OUTBOX_DLQ_PATH=uploads/audit-queue
# The DLQ directory is mounted as a Docker named volume so the
# deadman'd events persist across container restarts and are
# visible from the host filesystem (the audit_queue volume
# appears under /var/lib/docker/volumes/dfpos_audit_queue/).
ALLOW_NEGATIVE_INVENTORY=false
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
API_AUTH_RATE_LIMIT_ATTEMPTS=60
API_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Intelligence Microservice
INTELLIGENCE_ENABLED=true
INTELLIGENCE_SERVICE_URL=http://intelligence:8091
INTELLIGENCE_INTERNAL_API_TOKEN=change-me-intelligence-token
INTELLIGENCE_DATABASE_URL=postgresql+asyncpg://dfp_intelligence:dfp_intelligence_password@localhost:5433/dfp_intelligence
INTELLIGENCE_POSTGRES_DB=dfp_intelligence
INTELLIGENCE_POSTGRES_USER=dfp_intelligence
INTELLIGENCE_POSTGRES_PASSWORD=change-me-intelligence-db
INTELLIGENCE_AUDIT_LOG_BASE_URL=http://audit-log-service:8090
INTELLIGENCE_AUDIT_LOG_TOKEN=change-me-audit-token
INTELLIGENCE_AUDIT_LOG_ENABLED=false
INTELLIGENCE_LEGACY_MARIADB_HOST=
INTELLIGENCE_LEGACY_MARIADB_PORT=3306

# Trend Scout Microservice
TREND_SCOUT_ENABLED=true
TREND_SCOUT_SERVICE_URL=http://trend-scout:8093
TREND_SCOUT_INTERNAL_API_TOKEN=change-me-trend-scout-token
TREND_SCOUT_DATABASE_URL=postgresql+asyncpg://dfp_trend_scout:change-me-trend-scout-db@db:5432/dfp_trend_scout
TREND_SCOUT_POSTGRES_DB=dfp_trend_scout
TREND_SCOUT_POSTGRES_USER=dfp_trend_scout
TREND_SCOUT_POSTGRES_PASSWORD=change-me-trend-scout-db
TREND_SCOUT_REDIS_URL=redis://redis:6379/2
TREND_SCOUT_CELERY_BROKER_URL=redis://redis:6379/1
TREND_SCOUT_CELERY_RESULT_BACKEND=redis://redis:6379/1
TREND_SCOUT_CELERY_QUEUE=trend_scout
TREND_SCOUT_CELERY_TASK_PRIORITY=1
TREND_SCOUT_CELERY_DEFAULT_PRIORITY=5
TREND_SCOUT_CELERY_MAX_PRIORITY=10
TREND_SCOUT_FETCHER_POOL_WORKERS=4
TREND_SCOUT_FETCHER_TIMEOUT_SECONDS=30
TREND_SCOUT_PIPELINE_SOFT_TIME_LIMIT_SECONDS=900
TREND_SCOUT_PIPELINE_HARD_TIME_LIMIT_SECONDS=960
LAST30DAYS_RAW_FILE=

# Firecrawl-compatible internal scrape adapter for Trend Scout.
# Default OFF. Enable only after reviewing docs/compliance/firecrawl_etsy_opt_in.md.
FIRECRAWL_ENABLED=false
FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=change-me-firecrawl-api-key
FIRECRAWL_BULL_AUTH_KEY=change-me-firecrawl-bull-auth-key
FIRECRAWL_NUQ_USER=dfp_firecrawl
FIRECRAWL_NUQ_PASSWORD=change-me-firecrawl-nuq-password
FIRECRAWL_RESPECT_ROBOTS_TXT=true
FIRECRAWL_WEEKLY_CREDIT_CAP=2000
FIRECRAWL_DISABLE_TARGETS=
FIRECRAWL_ALLOW_ETSY=false
FIRECRAWL_ETSY_RUN_PROBABILITY=0.15
FIRECRAWL_ETSY_MIN_DAYS_BETWEEN_RUNS=14
FIRECRAWL_ETSY_MIN_INTERVAL_SECONDS=30
FIRECRAWL_ETSY_MAX_PAGES_PER_RUN=20
FIRECRAWL_ADAPTER_MAX_RESPONSE_BYTES=1500000
FIRECRAWL_ADAPTER_TIMEOUT_SECONDS=20
FIRECRAWL_ADAPTER_USER_AGENT=DFPosTrendScout/0.1 (+internal research; contact Dude Fish Printing)
INTELLIGENCE_LEGACY_MARIADB_DATABASE=
INTELLIGENCE_LEGACY_MARIADB_USER=
INTELLIGENCE_LEGACY_MARIADB_PASSWORD=

# Audit Log database used by docker-compose.yml
AUDIT_POSTGRES_DB=dfp_audit
AUDIT_POSTGRES_USER=dfp_audit
AUDIT_POSTGRES_PASSWORD=change-me-audit-db
AUDIT_HASH_SECRET=change-me-audit-hash-secret

# Optional API docs service, used with docker compose --profile docs
DOCS_USERNAME=docs-admin
DOCS_PASSWORD=change-me-docs-password
DOCS_AUTH_REQUIRED=true

# Slicer Microservice
SLICER_ENABLED=true
SLICER_SERVICE_URL=http://slicer:8092
SLICER_INTERNAL_API_TOKEN=replace-with-a-random-32-byte-token
SLICER_ARTIFACT_MAX_BYTES=536870912
SLICER_BAMBU_STUDIO_PATH=/opt/bambu-studio/AppRun
SLICER_BAMBU_PROFILE_ROOT=/opt/bambu-studio/resources/profiles/BBL
SLICER_ENGINE_ORDER=bambu,prusa
SLICER_PRUSA_SLICER_PATH=prusa-slicer
SLICER_SLICE_TIMEOUT_SECONDS=600
SLICER_METADATA_HEADER_MAX_BYTES=6144
SLICER_MAX_MODEL_BYTES=268435456

# Booth Mode
BOOTH_MODE_SNOOZE_MINUTES=30
